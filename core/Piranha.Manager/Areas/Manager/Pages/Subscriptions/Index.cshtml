@page "~/manager/subscriptions"
@model Piranha.Manager.Areas.Manager.Pages.Subscriptions.IndexModel
@inject ManagerLocalizer Localizer
@using Piranha.Events
@{
    ViewBag.Title = "Subscriptions";
    ViewBag.MenuItem = "Subscriptions";
    var eventTypes = Enum.GetNames(typeof(EventType));
    var eventStatus = Enum.GetNames(typeof(EventStatus));
}

@section script {
    <script>
        // Open modal for add or edit
        $('#addModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var modal = $(this);

            // If editing, fill fields
            var id = button.data('id') || '';
            var eventType = button.data('eventtype') || '';
            var eventStatus = button.data('eventstatus') || '';
            var callbackUrl = button.data('callbackurl') || '';
            var tags = button.data('tags') || '';

            modal.find('#SubscriptionId').val(id);
            modal.find('#EventType').val(eventType);
            modal.find('#EventStatus').val(eventStatus);
            modal.find('#CallbackUrl').val(callbackUrl);
            modal.find('#Tags').val(tags);

            // Set modal title and button
            if (id) {
                modal.find('.modal-title').text('Edit Subscription');
                modal.find('#saveBtn').text('Update');
            } else {
                modal.find('.modal-title').text('Add Subscription');
                modal.find('#saveBtn').text('Add');
            }
        });

        // Clear modal fields on close
        $('#addModal').on('hidden.bs.modal', function () {
            $(this).find('form')[0].reset();
            $(this).find('#SubscriptionId').val('');
        });

        $(document).ready(function () {
            // Hide error alert after 4 seconds
            setTimeout(function () {
                var alert = document.getElementById('pageError');
                if (alert) {
                    alert.classList.add('hide');
                    // Optionally remove it from DOM entirely after fade-out
                    setTimeout(function () {
                        alert.remove();
                    }, 500); 
                }
            }, 4000);
        });
    </script>
}

<style>
    .btn-edit i {
        color: var(--bs-primary);
        transition: color 0.2s ease;
    }

    .btn-edit:hover i {
        color: white;
    }

    .btn-delete i {
        color: var(--bs-danger);
        transition: color 0.2s ease;
    }

    .btn-delete:hover i {
        color: white;
    }

    .fade-out-alert {
        transition: opacity 0.5s ease-out;
    }

    .fade-out-alert.hide {
        opacity: 0;
    }
</style>

<div id="subscriptions">
    <div class="top">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">@Localizer.Menu["System"]</li>
                <li class="breadcrumb-item active" aria-current="page">@ViewBag.Title</li>
            </ol>
        </nav>
        <div class="container-fluid">
            <div class="top-nav">
                <form method="post" asp-page-handler="DeleteAll" class="d-inline">
                    <button type="submit" class="btn btn-danger btn-sm">
                        <i class="fas fa-trash"></i> @Localizer.General["Delete All"]
                    </button>
                </form>
                <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addModal">
                    <i class="fas fa-plus"></i> @Localizer.General["Add"]
                </button>
            </div>
        </div>
    </div>

    <div class="app ready">
        <div class="container-fluid">
            <div class="row">
                <div class="col">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger fade-out-alert" id="pageError">@Model.ErrorMessage</div>
                    }
                    <table class="table table-borderless table-hover">
                        <thead>
                            <tr>
                                <th class="w-20">Event Type</th>
                                <th class="w-20">Event Status</th>
                                <th class="w-25">Callback Url</th>
                                <th class="w-20">Tags</th>
                                <th class="w-25">Id</th>
                                <th class="actions two">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!Model.Subscriptions.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">No subscriptions found.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var sub in Model.Subscriptions)
                            {
                                <tr>
                                    <td>@sub.EventType</td>
                                    <td>@sub.EventStatus</td>
                                    <td>@sub.CallbackUrl</td>
                                    <td>@sub.Tags</td>
                                    <td class="text-monospace small">@sub.Id</td>
                                    <td class="actions two">
                                        <div class="d-flex align-items-center justify-content-center">

                                            <!-- Edit Button -->
                                            <button type="button"
                                                    class="btn btn-outline-primary btn-sm btn-edit d-flex align-items-center justify-content-center mx-1"
                                                    style="width:32px; height:32px; padding:0;"
                                                    data-toggle="modal"
                                                    data-target="#addModal"
                                                    data-id="@sub.Id"
                                                    data-eventtype="@sub.EventType"
                                                    data-eventstatus="@sub.EventStatus"
                                                    data-callbackurl="@sub.CallbackUrl"
                                                    data-tags="@sub.Tags"
                                                    title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </button>

                                            <!-- Delete Button -->
                                            <form asp-page-handler="Delete" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@sub.Id" />
                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm btn-delete d-flex align-items-center justify-content-center mx-1"
                                                        style="width:32px; height:32px; padding:0;"
                                                        title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Subscription Modal -->
<div class="modal fade" id="addModal" tabindex="-1" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <form method="post" asp-page-handler="AddOrUpdate">
        <input type="hidden" id="SubscriptionId" name="Id" value="" />
        <div class="modal-header">
          <h5 class="modal-title" id="addModalLabel">Add Subscription</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>Event Type</label>
                <select id="EventType" name="EventType" class="form-control" required>
                    @foreach (var type in eventTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Event Status</label>
                <select id="EventStatus" name="EventStatus" class="form-control" required>
                    @foreach (var status in eventStatus)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Callback Url</label>
                <input type="url" id="CallbackUrl" name="CallbackUrl" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Tags</label>
                <input type="text" id="Tags" name="Tags" class="form-control" />
            </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          <button type="submit" id="saveBtn" class="btn btn-primary">Add</button>
        </div>
      </form>
    </div>
  </div>
</div>